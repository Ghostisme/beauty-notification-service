  "sync": {
    "comment": "API模式: 拉取最近N分钟内更新的订单; 去重记录按商户分文件存储 state_<account_id>.json",
    "lookback_minutes": 60
  },
  "serve": {
    "comment": "常驻服务模式(python sync.py --serve)配置: interval_minutes 轮询间隔; watch_dir 为导出文件监听目录; merchant 指定文件模式推给哪个商户(name或序号, 默认第一个)",
    "interval_minutes": 30,
    "watch_dir": "data/incoming",
    "merchant": ""
  }
