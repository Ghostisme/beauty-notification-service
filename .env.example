# ========================================
# 抖音生活服务配置
# ========================================

# 应用凭证(在开放平台控制台获取)
DOUYIN_CLIENT_KEY=你的Client_Key
DOUYIN_CLIENT_SECRET=你的Client_Secret

# access_token 在签发有效期前提前刷新秒数(默认300, 7200秒 token 建议保留默认值)
DOUYIN_TOKEN_REFRESH_ADVANCE=300
# 业务接口相邻请求最小间隔毫秒数(默认60,约16 QPS)
DOUYIN_MIN_REQUEST_INTERVAL=60

# SPI回调验证Token(自定义,用于验证回调来源)
DOUYIN_SPI_TOKEN=your_random_token_here

# ========================================
# 企业微信配置
# ========================================

# 企业信息
WEWORK_CORP_ID=企业ID
WEWORK_AGENT_ID=应用ID
WEWORK_SECRET=应用Secret

# 发送者(员工UserID,需要已加入外部客户群)
WEWORK_SENDER_USERID=员工账号

# ========================================
# 存储配置
# ========================================

# 存储类型: mysql | json | txt
STORAGE_TYPE=json

# 数据存储目录(json/txt模式使用)
STORAGE_DATA_DIR=./data

# ========================================
# 数据库配置 (STORAGE_TYPE=mysql 时使用)
# ========================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=beauty_user
DB_PASSWORD=数据库密码
DB_NAME=beauty_notification

# ========================================
# 服务器配置
# ========================================

PORT=3000
NODE_ENV=production

# HTTPS配置(生产环境必须使用HTTPS)
# SSL_KEY_PATH=/path/to/ssl/key.pem
# SSL_CERT_PATH=/path/to/ssl/cert.pem
